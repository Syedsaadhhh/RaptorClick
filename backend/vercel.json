{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'RaptorClick API build ready'",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
